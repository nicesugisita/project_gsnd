"""TTS 텍스트 변환, 청크 폴백, 서버 전송 헬퍼"""


import io
import requests
import httpx
import logging
import re
import traceback
import asyncio
import base64
import binascii
import json
from typing import Any, List, Optional, Tuple

from typing import Any, Dict, Optional
from core.config import Config
from services import call_llm_api
from services.tts_service import request_tts_stream

from .wav_utils import _merge_wav_base64_segments

logger = logging.getLogger(__name__)

TTS_STREAM_API_URL = f"{Config.TTS_SERVER_URL.rstrip('/')}/service/ttsstream"

def _extract_tts_raw_base64(tts_response: Any) -> Optional[str]:
    if not isinstance(tts_response, dict):
        return None

    result = tts_response.get("result")
    if not isinstance(result, dict):
        return None

    raw_base64 = result.get("raw_base64")
    if isinstance(raw_base64, str) and raw_base64.strip():
        return raw_base64.strip()

    return None


def remove_raw_base64(data):
    if isinstance(data, dict):
        return {
            k: remove_raw_base64(v)
            for k, v in data.items()
            if k != "raw_base64"
        }
    elif isinstance(data, list):
        return [remove_raw_base64(v) for v in data]
    return data


def _split_text_for_tts(text: str, max_chars: int = 220) -> list[str]:
    normalized = re.sub(r"\s+", " ", text).strip()
    if not normalized:
        return []

    if len(normalized) <= max_chars:
        return [normalized]

    sentence_units = [
        sentence.strip() for sentence in re.split(r"(?<=[.!?。！？])\s+|\n+", normalized)
        if sentence.strip()
    ]

    chunks: list[str] = []
    current = ""

    def flush_current() -> None:
        nonlocal current
        if current:
            chunks.append(current)
            current = ""

    for sentence in sentence_units:
        if len(sentence) > max_chars:
            flush_current()
            for index in range(0, len(sentence), max_chars):
                unit = sentence[index:index + max_chars].strip()
                if unit:
                    chunks.append(unit)
            continue

        if not current:
            current = sentence
            continue

        candidate = f"{current} {sentence}"
        if len(candidate) <= max_chars:
            current = candidate
        else:
            flush_current()
            current = sentence

    flush_current()
    return chunks if chunks else [normalized]


async def _request_tts_with_chunk_fallback(text: str) -> Dict[str, Any]:
    primary_response = await request_tts_stream(text)
    primary_raw = _extract_tts_raw_base64(primary_response)
    if primary_raw:
        return primary_response

    chunks = _split_text_for_tts(text)
    if len(chunks) <= 1:
        return primary_response

    logger.warning("TTS 폴백 분할 합성 시작: 총 %d개 청크", len(chunks))

    chunk_raw_segments: list[str] = []
    total_duration = 0.0

    for index, chunk in enumerate(chunks, start=1):
        chunk_response = await request_tts_stream(chunk)
        chunk_raw = _extract_tts_raw_base64(chunk_response)

        if not chunk_raw:
            logger.error("TTS 폴백 청크 실패: index=%d, text_length=%d", index, len(chunk))
            return primary_response

        chunk_raw_segments.append(chunk_raw)

        chunk_result = chunk_response.get("result") if isinstance(chunk_response, dict) else None
        if isinstance(chunk_result, dict):
            duration = chunk_result.get("duration")
            if isinstance(duration, (int, float)):
                total_duration += float(duration)

    merged_raw_base64 = _merge_wav_base64_segments(chunk_raw_segments)
    logger.info("TTS 폴백 분할 합성 성공: merged_segments=%d", len(chunk_raw_segments))

    return {
        "result": {
            "raw_base64": merged_raw_base64,
            "duration": total_duration,
        },
        "errorCode": 0,
        "errorMessage": "None",
    }


async def convert_text_for_tts(text: str) -> Optional[str]:
    """
    TTS 음성 출력에 적합하도록 텍스트를 변환합니다.
    voice_print_before_prompt.txt를 사용하여 LLM으로 변환합니다.
    """
    try:
        from services.llm_service import load_voice_print_before_prompt

        voice_prompt = load_voice_print_before_prompt()
        if not voice_prompt:
            logger.warning("[TTS TEXT CONVERSION] Voice print prompt not found, returning original text")
            return text

        call_messages = [{"role": "user", "content": f"다음 텍스트를 TTS용 스크립트로 변환하세요:\n\n<변환할_텍스트>\n{text}\n</변환할_텍스트>"}]

        response = await call_llm_api(
            temperature=0,
            messages=call_messages,
            extra_system_prompts=[voice_prompt],
            max_tokens=4000,
            timeout=300,
        )

        if isinstance(response, str):
            converted_text = response.strip()
            logger.info(f"=== LLM 변환 결과 ===\n{converted_text}...")

            result_text = remove_audio_tags(converted_text)
            logger.info(f"=== [음성 N] 제거 변환 결과 ===\n{result_text}...")
        return result_text

    except Exception as e:
        logger.error(f"[TTS TEXT CONVERSION] Error converting text for TTS: {e}", exc_info=True)
        return text

def send_text_to_tts_server(text: str) -> Optional[bytes]:
    """텍스트를 TTS 서버로 전송하여 음성 파일로 변환합니다."""
    try:
        payload = _get_tts_stream_api_payload(text)
        response = requests.post(TTS_STREAM_API_URL, json=payload, timeout=30)

        logger.info(f"TTS 서버 URL: {TTS_STREAM_API_URL}")
        logger.info(f"TTS 텍스트: {text[:]}...")
        logger.info(f"TTS 텍스트 길이: {len(text)} characters")

        if response.status_code == 200:
            return response.content
        else:
            logger.error(f"TTS 서버 오류: {response.status_code} - {response.text[:200]}")
            return None

    except requests.Timeout:
        logger.error("TTS 서버 타임아웃")
        return None
    except Exception as e:
        logger.error(f"TTS 서버 통신 오류: {e}")
        logger.error(traceback.format_exc())
        return None

#segment 별 base64 통합하여 한개로 합친 후 json format string으로 반환
async def send_tts_request_and_collect_base64(segments: list):
    timeout = httpx.Timeout(20.0, connect=5.0)

    async def fetch_segment(
        client: httpx.AsyncClient,
        index: int,
        segment: Any,
    ) -> Tuple[int, Optional[bytes], float, Optional[str]]:
        text = getattr(segment, "text", None)

        if not text or not isinstance(text, str):
            return index, None, 0.0, f"Segment {index} error: invalid or empty text"

        payload = _get_tts_stream_api_payload(text)

        try:
            logger.info("===================start to send ttsstream=======================")
            response = await client.post(TTS_STREAM_API_URL, json=payload)
            response.raise_for_status()

            data = response.json()
            if not isinstance(data, dict):
                return index, None, 0.0, f"Segment {index} error: response JSON is not an object"

            result = data.get("result")
            if not isinstance(result, dict):
                return index, None, 0.0, f"Segment {index} error: missing or invalid 'result'"

            raw_b64 = result.get("raw_base64")
            duration = result.get("duration", 0.0)

            if raw_b64 is None:
                return index, None, 0.0, f"Segment {index} error: missing raw_base64"

            if not isinstance(raw_b64, str):
                return index, None, 0.0, f"Segment {index} error: raw_base64 is not a string"

            try:
                pcm_bytes = base64.b64decode(raw_b64, validate=True)
            except (binascii.Error, ValueError) as e:
                return index, None, 0.0, f"Segment {index} error: invalid base64 - {str(e)}"

            try:
                duration_value = float(duration)
            except (TypeError, ValueError):
                duration_value = 0.0

            return index, pcm_bytes, duration_value, None

        except httpx.HTTPStatusError as e:
            return (
                index,
                None,
                0.0,
                f"Segment {index} error: HTTP {e.response.status_code} - {e.response.text}",
            )
        except httpx.RequestError as e:
            return index, None, 0.0, f"Segment {index} error: request failed - {str(e)}"
        except json.JSONDecodeError as e:
            return index, None, 0.0, f"Segment {index} error: invalid JSON response - {str(e)}"
        except Exception as e:
            return index, None, 0.0, f"Segment {index} error: {str(e)}"
    async with httpx.AsyncClient(timeout=timeout) as client:
        tasks = [
            fetch_segment(client, index, segment)
            for index, segment in enumerate(segments)
        ]
        results = await asyncio.gather(*tasks, return_exceptions=False)

    # 응답 완료 순서와 무관하게 index 기준으로 정렬해서 원래 순서 보장
    results.sort(key=lambda x: x[0])

    merged_pcm_bytes = bytearray()
    total_duration = 0.0
    error_messages = []

    for index, pcm_bytes, duration, error in results:
        if error:
            error_messages.append(error)
            continue

        if pcm_bytes:
            merged_pcm_bytes.extend(pcm_bytes)
            total_duration += duration

    merged_b64 = (
        base64.b64encode(bytes(merged_pcm_bytes)).decode("utf-8")
        if merged_pcm_bytes
        else ""
    )

    return {
        "result": {
                  "duration": round(total_duration, 4),
                  "raw_base64": merged_b64
                },
        "errorMessage": " | ".join(error_messages) if error_messages else "None",
        "errorCode": 0 if not error_messages else 206
    }

async def stream_tts_base64(segments: list):
    url = "http://10.215.18.237:45200/service/ttsstream"
#    master_key = "master260317225911776914"

    async with httpx.AsyncClient() as client:
        # 1. 모든 세그먼트에 대해 즉시 비동기 태스크 생성 (병렬 요청 시작)
        tasks = []
        for segment in segments:
            text_to_send = segment.text.strip()
            if not text_to_send:
                continue

            payload = _get_tts_stream_api_payload(text_to_send)

            # 요청을 예약만 하고 바로 다음으로 넘어감
            tasks.append(asyncio.create_task(client.post(TTS_STREAM_API_URL, json=payload, timeout=15.0)))

        # 2. 생성된 태스크들을 순서대로 기다리며(await) 즉시 yield
        for i, task in enumerate(tasks):
            try:
                # 해당 순서의 태스크가 완료될 때까지 기다림
                response = await task
                response.raise_for_status()
                data = response.json()

                result_part = data.get("result", {})
                b64_string = result_part.get("raw_base64")
                duration = result_part.get("duration", 0.0)

                if b64_string:
                    yield {
                        "result": {"raw_base64": b64_string, "duration": duration},
                        "errorCode": 0,
                        "errorMessage": "None"
                    }
                else:
                    yield {
                        "result": {"raw_base64": "", "duration": 0},
                        "errorCode": 204,
                        "errorMessage": f"Segment {i + 1}: No audio data"
                    }

            except Exception as e:
                logger.error(f"Streaming Error at segment {i + 1}: {str(e)}")
                yield {
                    "result": {"raw_base64": "", "duration": 0},
                    "errorCode": 500,
                    "errorMessage": f"Segment {i + 1} Error: {str(e)}"
                }


# 음성 문장 전처리 프롬프트(voice_print_before_propmt.txt)가 적용된 문장에서  [음성 N] 제거
# 프롬프트에[음성 N]삭제 되면 해당 메소드 적용 해제
def remove_audio_tags(text):
    clean_text = re.sub(r'\[음성\d+\]', '', text)
    # 앞뒤 공백을 제거하고 줄바꿈이 중복될 경우 정리
    return clean_text.strip()

#TTS STREAM API 요청 Payload 
def _get_tts_stream_api_payload(text: str) -> dict:
    return {
        "masterKey": Config.TTS_MASTER_KEY,
        "text": text,
        "sid":  Config.SID,
        "tempo": Config.TEMPO,
        "padSilence": Config.PAD_SILENCE,
        "amplify": Config.AMPLIFY,
        "gainDb": Config.GAIN_DB
    }


